# Copy to .env.local and fill in. Do not commit .env.local.
# Neon is provisioned via: vercel integration add neon

# Pooled Neon connection (app runtime)
DATABASE_URL=

# Unpooled (migrations / drizzle-kit)
# DATABASE_URL_UNPOOLED=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Resend API key (Auth.js env name)
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Simplicity Love & Justice <info@talksfromthewarehouse.co.uk>"

# Mailchimp — Talks From The Warehouse audience (auto-subscribe on course sign-in)
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=
# Optional override; default is the TFTW list unsubscribe URL
# MAILCHIMP_UNSUBSCRIBE_URL=

# Local / Playwright test sign-in (Credentials provider "e2e")
AUTH_E2E_SECRET=
# Allow e2e provider without secret match in development only
AUTH_DEV_LOGIN=1

# Staging password gate (slj.round-table.co.uk)
# STAGING_BASIC_AUTH=1
# STAGING_BASIC_AUTH_USER=slj
# STAGING_BASIC_AUTH_PASSWORD=

# E2E only: set by Playwright webServer — never enable in production
# (bypasses auth for /course and /worksheets/print).
# NEXT_PUBLIC_PLAYWRIGHT_E2E=1

# Monitoring / analytics (see docs/Monitoring.md)
# BETTER_STACK_UPTIME_API_TOKEN=   # scripts/setup-monitoring.ts
# Pushover (Critical Alerts on phone — Better Stack free has no iOS push)
# PUSHOVER_API_TOKEN=              # Pushover → your application API token
# PUSHOVER_USER_KEY=               # Pushover dashboard user key
# BETTER_STACK_WEBHOOK_SECRET=     # shared secret for /api/webhooks/betterstack
# Weekly digest (Monday cron → Resend)
# CRON_SECRET=
# WEEKLY_DIGEST_TO=louis@round-table.co.uk,theodgersfamily@aol.com
# VERCEL_ANALYTICS_TOKEN=          # Dashboard token (vercel.com/account/tokens); not a CLI login token
# VERCEL_TOKEN=                    # legacy fallback — prefer VERCEL_ANALYTICS_TOKEN
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=                      # same DSN ok for server
# SENTRY_AUTH_TOKEN=               # optional: source maps / API
# SENTRY_ORG=
# SENTRY_PROJECT=slj

# Mailchimp subscribe webhook (?secret=)
# MAILCHIMP_WEBHOOK_SECRET=
